---
// Spezialanfertigung — bewusst die einfachste Fassung (Manolo, 11.08.2026):
// eine Seite, drei Beispiele, ein Mail-Knopf. Kein Formular, kein Backend.
// Anfragen laufen per Mail; Machbarkeit wird von Hand geprueft.
import BaseLayout from '../layouts/BaseLayout.astro';

const MAIL = 'manuel_looser@bluewin.ch';
const BETREFF = 'Anfrage Spezialanfertigung';
const VORLAGE = [
  'Hallo KohliLab',
  '',
  'Was ich brauche:',
  '',
  '',
  'Masse (falls bekannt):',
  'Stückzahl:',
  '',
  'Fotos oder 3D-Datei (3MF/STL/STEP) hänge ich dieser Mail gleich an.',
  '',
  'Gruss',
].join('\n');
// RFC 6068 verlangt CRLF (%0D%0A) fuer Zeilenumbrueche im mailto-Body —
// mit blossem %0A klappt manche Mail-App die Vorlage auf eine Zeile zusammen.
const mailtoHref = `mailto:${MAIL}?subject=${encodeURIComponent(BETREFF)}`
  + `&body=${encodeURIComponent(VORLAGE.replace(/\n/g, '\r\n'))}`;

// Telefon fuer unverbindliche Anfragen (Manolo 14.08.2026). Als tel:-Link,
// damit ein Anruf vom Handy ein Antippen ist.
const TELEFON = '076 386 89 10';
const telHref = 'tel:+41' + TELEFON.replace(/\D/g, '').replace(/^0/, '');

// Beispielbilder: echte Auftraege statt Ventilkappen-Renderings
// (Manolo 14.08.2026). Alle im Hochformat — die Karten stellen bewusst
// nichts beschnitten dar, siehe .card .thumb im globalen CSS.
const beispiele = [
  {
    bild: '/bilder/spezial-statue.webp',
    alt: 'Gedruckte Figur einer Person, nach Fotos modelliert, mit gestrickter Mütze',
    titel: 'Vom Foto zum Teil',
    text: 'Aus Fotos wird ein 3D-Modell und daraus dein Einzelstück — Figuren, Büsten, Nachbildungen in Farbe.',
  },
  {
    bild: '/bilder/spezial-relief.webp',
    alt: 'Gedrucktes Grundriss-Relief neben dem Bauplan, aus dem es entstanden ist',
    titel: 'Teile nach Mass',
    text: 'Halterungen, Einsätze, Gehäuse, Ersatzteile: du bringst Masse, Zeichnung oder das defekte Teil — wir konstruieren und drucken. Aus einem PDF-Plan erzeugen wir auch ein Relief, wie den Grundriss im Bild.',
  },
  {
    bild: '/bilder/spezial-pilzlampe.webp',
    alt: 'Leuchtende Fliegenpilz-Lampe, aus einem fertigen 3D-Modell gedruckt',
    titel: 'Dein Modell, gedruckt',
    text: 'Du hast schon eine 3MF-, STL- oder STEP-Datei? Wir prüfen sie und drucken in deinen Wunschfarben.',
  },
];
---
<BaseLayout
  title="Spezialanfertigung — KohliLab"
  description="3D-Druck nach deiner Vorgabe: Ersatzteile, Halterungen, Gehäuse, persönliche Einzelstücke oder dein fertiges 3D-Modell. Kostenlose Machbarkeitsprüfung, gedruckt in Bühler AR."
>
  <section class="block spezial-kopf">
    <div class="kopf-text">
      <h1>Spezialanfertigung</h1>
      <p class="lead">
        Wir bauen und drucken Einzelstücke nach deiner Vorgabe — Ersatzteil,
        Halterung, Gehäuse, persönliches Stück oder dein fertiges 3D-Modell.
        Schick uns deine Anfrage, wir prüfen kostenlos, ob es machbar ist.
        Du zahlst erst, wenn wir Ja sagen und du die Offerte annimmst.
      </p>
      <div class="kopf-cta">
        <a class="btn primary" href={mailtoHref}>Anfrage per Mail senden</a>
        <a class="btn ghost" href={telHref}>{TELEFON} anrufen</a>
      </div>
      <p class="anrufhinweis">
        Lieber kurz reden? Ruf einfach an — unverbindlich, auch wenn du nur
        wissen willst, ob so etwas überhaupt geht.
      </p>
    </div>
    <div class="kopf-bild">
      <img src="/bilder/spezial-titel.webp" width="1050" height="1400"
           alt="Gedruckte Schutzhalterungen mit Klemmringen, frisch vom Druckbett" />
      <span class="bildlabel">AUFTRAGSARBEIT · BÜHLER AR</span>
    </div>
  </section>

  <section class="block">
    <p class="mailhinweis">
      Der Knopf öffnet dein Mailprogramm mit einer kurzen Vorlage.
      Es passiert nichts? Dann schreib uns von Hand — Adresse und Vorlage
      stehen hier, Fotos oder 3D-Dateien einfach anhängen:
    </p>
    <div class="mailkasten">
      <div class="mailzeile">
        <code id="mail-adresse">{MAIL}</code>
        <button class="btn ghost klein" type="button" data-kopiere="mail-adresse">Adresse kopieren</button>
      </div>
      <pre id="mail-vorlage">{`Betreff: ${BETREFF}\n\n${VORLAGE}`}</pre>
      <button class="btn ghost klein" type="button" data-kopiere="mail-vorlage">Vorlage kopieren</button>
    </div>
    <script is:inline>
      // Kopier-Fallback: funktioniert auch ohne eingerichtetes Mailprogramm.
      // Clipboard-API zuerst, execCommand als Reserve fuer aeltere Browser.
      document.querySelectorAll('[data-kopiere]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = document.getElementById(btn.dataset.kopiere).textContent;
          function fertig() {
            var alt = btn.textContent;
            btn.textContent = 'Kopiert ✓';
            setTimeout(function () { btn.textContent = alt; }, 1600);
          }
          function reserve() {
            var ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            ta.remove();
            fertig();
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(fertig, reserve);
          } else {
            reserve();
          }
        });
      });
    </script>
  </section>

  <section class="block">
    <h2>Beispiele</h2>
    <div class="cards">
      {beispiele.map((b) => (
        <div class="card linie">
          <div class="thumb linie-thumb">
            <img src={b.bild} alt={b.alt} loading="lazy" width="900" height="563" />
          </div>
          <div class="meta">
            <div>
              <div class="nm">{b.titel}</div>
              <div class="ds">{b.text}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <h2>So läuft's</h2>
    <div class="steps">
      <div class="step">
        <div class="num">SCHRITT 1</div>
        <h3>Anfragen</h3>
        <p>
          Mail mit Beschreibung, Massen und Stückzahl — Fotos oder
          3D-Datei anhängen. Je konkreter, desto schneller die Antwort.
        </p>
      </div>
      <div class="step">
        <div class="num">SCHRITT 2</div>
        <h3>Wir prüfen</h3>
        <p>
          Kostenlos und ehrlich: machbar, machbar mit Anpassung oder nicht
          machbar — zusammen mit einer Offerte.
        </p>
      </div>
      <div class="step">
        <div class="num">SCHRITT 3</div>
        <h3>Drucken &amp; liefern</h3>
        <p>
          Nach deinem Ja drucken wir in Bühler AR und schicken dir dein
          Teil. Nicht machbar heisst: du zahlst nichts.
        </p>
      </div>
    </div>
  </section>

  <section class="block">
    <h2>Gut zu wissen</h2>
    <div class="prose grenzen">
      <ul>
        <li>FDM-Kunststoffdruck (PLA u.&nbsp;a.) — robuste Alltagsteile, keine Sicherheits- oder Lebensmittelteile.</li>
        <li>Feine Details unter ~0.8&nbsp;mm und frei hängende dünne Teile drucken nicht sauber.</li>
        <li>Geschützte Logos und Marken drucken wir nur für den Privatgebrauch, nicht für den Verkauf.</li>
        <li>Im Zweifel: einfach fragen — die Prüfung kostet nichts.</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .block h1 { font-size: 40px; margin-bottom: 14px; }

  /* Kopf: Text links, Titelbild rechts. Das Foto ist Hochformat (3:4) wie
     alle Druckbett-Aufnahmen — es wird formatfuellend zugeschnitten, weil es
     hier als Stimmungsbild dient und nicht als Produktabbildung. */
  .spezial-kopf { display: grid; gap: 28px; align-items: center;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  .kopf-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .anrufhinweis { color: var(--muted); font-size: 13px; margin-top: 10px; max-width: 46ch; }
  .kopf-bild { position: relative; aspect-ratio: 3 / 4; border-radius: 10px;
    overflow: hidden; border: 1px solid var(--line); background: var(--panel); }
  .kopf-bild img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bildlabel { position: absolute; left: 10px; bottom: 10px;
    font-family: var(--mono); font-size: 9px; letter-spacing: 1.1px;
    color: var(--muted); background: rgba(20, 21, 23, 0.72);
    border: 1px solid var(--line); border-radius: 4px; padding: 3px 8px; }

  /* Am Handy zuerst der Text, dann das Bild — und flacher, damit der
     Mail-Knopf nicht unter die Falz rutscht. */
  @media (max-width: 720px) {
    .spezial-kopf { grid-template-columns: 1fr; gap: 18px; }
    .kopf-bild { aspect-ratio: 4 / 3; }
    .block h1 { font-size: 32px; }
  }
  .mailhinweis { color: var(--muted); font-size: 13px; margin-top: 14px; }
  .mailhinweis a { color: var(--acc2); }
  .grenzen { padding: 0; max-width: 62ch; }
  .mailkasten { background: var(--panel); border: 1px solid var(--line);
    border-radius: 8px; padding: 16px 18px; max-width: 560px; margin-top: 10px; }
  .mailzeile { display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    margin-bottom: 12px; }
  .mailzeile code { font-family: var(--mono); font-size: 14px; color: var(--acc2); }
  .mailkasten pre { font-family: var(--mono); font-size: 12.5px; color: var(--muted);
    line-height: 1.7; white-space: pre-wrap; border-top: 1px solid var(--line);
    padding-top: 12px; margin-bottom: 12px; }
  .btn.klein { padding: 8px 14px; font-size: 11px; }
</style>

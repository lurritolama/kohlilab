---
import BaseLayout from '../layouts/BaseLayout.astro';
import KonfigFrame from '../components/KonfigFrame.astro';
import TestBanner from '../components/TestBanner.astro';
import { inTestphase } from '../lib/testphase';
import Kurzinfo from '../components/Kurzinfo.astro';
---
<BaseLayout
  title="QR-Schilder-Konfigurator — KohliLab"
  bild="/bilder/qr-schilder-titel.jpg"
  description="Gestalte dein eigenes 3D-gedrucktes QR-Schild: Form, Farben, WLAN/URL/vCard-Inhalt, Text und Logo — mit Echtzeit-3D-Vorschau und druckfertigem Farb-3MF."
>
  {inTestphase('schild') && <TestBanner />}
  <section class="block" style="padding-top:28px">
    <h2>QR-Schilder-Konfigurator</h2>
    <p class="lead">
      Dein QR-Schild, 3D-gedruckt und mehrfarbig: Grundform wählen, Inhalt
      eingeben (URL, WLAN, vCard …), Text und Logo platzieren — alles bündig
      als Farbflächen, direkt in der 3D-Vorschau. QR und Schrift bleiben
      immer dunkel auf heller Platte, damit jedes Handy den Code liest.
     
    </p>
  </section>
  <Kurzinfo />
  <KonfigFrame app="qr-schilder-app" titel="QR-Schilder-Konfigurator" mobil="ansehen" test={inTestphase('schild')} />

</BaseLayout>

<style>
</style>

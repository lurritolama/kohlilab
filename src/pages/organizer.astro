---
import BaseLayout from '../layouts/BaseLayout.astro';
// Bauzeit-Stempel als Cache-Buster: Browser cachen iframe-Inhalte gern
// ueber normale Reloads hinweg — mit neuer ?v= pro Deploy holt jeder
// Besucher nach einem Deploy automatisch die frische App.
const v = Date.now();
---
<BaseLayout
  title="Schubladen-Organizer nach Mass — KohliLab"
  description="Massgeschneiderter Schubladeneinsatz, 3D-gedruckt: Innenmass eingeben, Fächer frei einteilen, direkt in der 3D-Schublade gestalten — für Besteck, Büro, Werkzeug, Schrauben und mehr."
>
  <div class="test-banner">TESTPHASE — Konfigurator ausprobieren, 3MF herunterladen und Feedback geben. Bestellung folgt.</div>
  <section class="block" style="padding-top:28px">
    <h2>Schubladen-Organizer nach Mass</h2>
    <p class="lead">
      Miss deine Schublade innen aus, gib die Masse ein — und teile die Fächer
      direkt in der 3D-Schublade ein: Fach anklicken zum Teilen, Wände einfach
      verschieben. Für Besteck, Büro, Werkzeug, Schrauben, Schminke und alles
      andere, das endlich Ordnung braucht. Am besten am Desktop bedienen.
    </p>
  </section>
  <div class="konfig-frame">
    <iframe src={`/organizer-app/index.html?v=${v}`} title="Schubladen-Organizer-Konfigurator"></iframe>
  </div>
</BaseLayout>

<style>
  .test-banner{ background:#3b1a5e; color:#e5b8ff; font-family:var(--mono); font-size:12px;
    letter-spacing:1px; text-align:center; padding:9px 14px; border-bottom:1px solid #5b2a8e; }
  .konfig-frame{ padding:0 26px 48px; }
  .konfig-frame iframe{ width:100%; height:80vh; min-height:560px; border:1px solid var(--line);
    border-radius:10px; background:#141517; }
</style>

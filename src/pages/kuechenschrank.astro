---
// Küchenschrank-Einsätze nach Mass (14.09.2026, Regal-Fassung 16.09.):
// freistehende Regal-Einsätze für den Schrank-Korpus — Zwischenböden und
// senkrechte Trennwände mit Schwalbenschwanz/Steckkreuz, millimetergenau,
// von vorne gesteckt. Abgrenzung zum Schubladen-Organizer: der bleibt für Schubladen. Spezialeinsätze
// (Küchenrolle, Tempos, Folien) docken später an dasselbe Raster an.
import BaseLayout from '../layouts/BaseLayout.astro';
import KonfigFrame from '../components/KonfigFrame.astro';
import TestBanner from '../components/TestBanner.astro';
import { inTestphase } from '../lib/testphase';
import Kurzinfo from '../components/Kurzinfo.astro';
---
<BaseLayout
  title="Küchenschrank-Einsatz nach Mass — KohliLab"
  description="Gitter-Einsatz für den Küchenschrank nach Mass, 3D-gedruckt: Schrank ausmessen, Fächer mit steckbaren Trennwänden einteilen, direkt in 3D — für Teller, Bretter, Vorräte, Deckel. Trennwände jederzeit umsetzbar."
>
  {inTestphase('schrank') && <TestBanner />}
  <section class="block" style="padding-top:28px">
    <h2>Küchenschrank-Einsatz nach Mass</h2>
    <p class="lead">
      Miss deinen Schrank innen aus, gib die Masse ein — und teile den Einsatz
      direkt in 3D ein: Fach anklicken, Zwischenböden und senkrechte Trennwände
      millimetergenau verschieben. Das Regal wird frei in den Schrank gestellt,
      nichts wird geschraubt oder geklemmt. Böden und Trennwände greifen mit
      Schwalbenschwänzen und Steckkreuzen ineinander, alles wird von vorne
      gesteckt — für Teller, Bretter, Vorräte, Deckel und alles, was im Schrank
      Ordnung braucht.
    </p>
    <p class="lead lead-kurz">
      Masse eingeben, Fächer in 3D einteilen — Böden und Trennwände steckbar und umsetzbar.
    </p>
  </section>
  <Kurzinfo />
  <KonfigFrame app="schrank-app" titel="Küchenschrank-Einsatz-Konfigurator" mobil="ansehen" test={inTestphase('schrank')} />
</BaseLayout>

<style>
  .lead-kurz { display: none; }
  @media (max-width: 860px) {
    .lead { display: none; }
    .lead-kurz { display: block; }
  }
</style>

---
// Bereichsseite «Smart Home» (Manolo 14.11.2026): zweiter Bereich von KohliLab neben dem 3D-Druck, Akzent Türkis auf
// der schwarzen Basis. Der Zählerleser ist das erste Gerät; weitere kommen in src/data/produktlinien.ts dazu
// (bereich 'smart-home') und erscheinen dann hier und in der Produktübersicht der Startseite von selbst.
import BaseLayout from '../layouts/BaseLayout.astro';
import { linienIn } from '../data/produktlinien';

const geraete = linienIn('smart-home');
// «Zum 3D-Druck →» führt wie jeder interne Link mit dem 3D-Druck-Übergang weiter (Manolo 18.11.2026), hier auf die
// Produktübersicht der Startseite. Deren erste Kachelbilder holt der Browser vor, sobald man sich dem Link zuwendet
// (druck.js liest data-vorlade): so stehen sie schon da, wenn die Seite «gedruckt» wird.
const druckVorlade = linienIn('3d-druck').filter((l) => l.bild).slice(0, 6).map((l) => l.bild).join(' ');
const titel = 'Smart Home — KohliLab';
const beschreibung = 'Smart Home von KohliLab: kleine Geräte, die lokal arbeiten, ohne Cloud und ohne Konto, mit Gehäusen aus dem eigenen Drucklabor in Bühler AR. Als Erstes der Zählerleser für den Smart Meter E450.';
const figuren = [
  { bild: '/zaehlerleser-medien/figur_eule_links.webp', name: 'Eule', alt: 'Die Eule: schwarze Hülle, grosse orange Augen, oranger Schnabel.' },
  { bild: '/zaehlerleser-medien/figur_spinne_vorne.webp', name: 'Spinne', alt: 'Die Spinne: schwarze Hülle mit acht Beinen, acht orangen Augen und einem Lächeln.' },
  { bild: '/zaehlerleser-medien/figur_astronaut_rechts.webp', name: 'Astronaut', alt: 'Der Astronaut: helle Hülle, dunkles Visier mit zwei leuchtenden Augen, Antenne.' },
];
---
<BaseLayout title={titel} description={beschreibung} bild="/zaehlerleser-medien/og.jpg">
  <div class="sh sh-akzent">
    <section class="sh-held" aria-labelledby="sh-titel">
      <div class="sh-held-text">
        <span class="kicker">Neu bei KohliLab</span>
        <h1 id="sh-titel">Smart Home.<br /><span class="g">Aus der Werkstatt.</span></h1>
        <p class="sub">
          Kleine Geräte, die dein Zuhause ablesbar machen. Sie arbeiten lokal, ohne Cloud und ohne Konto, und geben
          ihre Werte per WLAN an dein eigenes System weiter. Elektronik und Software entstehen bei uns, die Gehäuse
          kommen aus dem eigenen Drucklabor in Bühler AR.
        </p>
        <div class="cta">
          <a class="btn primary" href="/smart-home/zaehlerleser">Zum Zählerleser</a>
          <a class="btn ghost" href="/smart-home/zaehlerleser#melden">Benachrichtigen, wenn verfügbar</a>
        </div>
        <div class="specs">
          <div><div class="n">Lokal</div><div class="l">ohne Cloud</div></div>
          <div><div class="n">Offen</div><div class="l">Home Assistant, MQTT</div></div>
          <div><div class="n">Gedruckt</div><div class="l">in Bühler AR</div></div>
        </div>
      </div>
      <div class="sh-held-bild">
        <img src="/zaehlerleser-medien/bild_trio.webp" width="1600" height="900" fetchpriority="high"
             alt="Drei Zählerleser als Eule, Spinne und Astronaut auf Stromzählern, ihre Augen leuchten." />
      </div>
    </section>

    <section class="block" id="geraete" aria-labelledby="sh-geraete">
      <h2 id="sh-geraete">Geräte</h2>
      <p class="lead">Der Zählerleser ist das erste Smart-Home-Gerät von KohliLab. Das nächste entsteht gerade in der Werkstatt.</p>
      <div class="sh-geraete">
        {geraete.map((g) => (
          <article class="sh-geraet">
            <a class="sh-geraet-bild" href={g.href ?? undefined} tabindex="-1" aria-hidden="true">
              {g.bildBereich ? (
                <img src={g.bildBereich.src} alt="" width={g.bildBereich.breite} height={g.bildBereich.hoehe} loading="lazy" decoding="async" />
              ) : g.bild && <img src={g.bild} alt="" width={g.breite} height={g.hoehe} loading="lazy" decoding="async" />}
            </a>
            <div class="sh-geraet-text">
              {g.status === 'bald' && <span class="sh-marke">Bald erhältlich</span>}
              <h3><a href={g.href ?? undefined}>{g.name}</a></h3>
              <p>{g.beschreibung}</p>
              {g.merkmale && (
                <ul class="sh-merkmale" aria-label="Merkmale">
                  {g.merkmale.map((m) => <li>{m}</li>)}
                </ul>
              )}
              <a class="sh-weiter" href={g.href ?? undefined} aria-label={`${g.name} ansehen`}>Ansehen →</a>
            </div>
          </article>
        ))}
        <article class="sh-geraet sh-folgt">
          <div class="sh-folgt-zeichen" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 96 96"><rect x="14" y="14" width="68" height="68" rx="10" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="7 6"/><path d="M48 34 v28 M34 48 h28" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
          </div>
          <div class="sh-geraet-text">
            <h3>Das nächste Gerät</h3>
            <p>entsteht gerade in der Werkstatt. Du hast eine Idee, was bei dir zu Hause gemessen oder geschaltet werden sollte? Schreib uns.</p>
            <a class="sh-weiter" href="/kontakt">Idee schicken →</a>
          </div>
        </article>
      </div>
    </section>

    <section class="block sh-labor" aria-labelledby="sh-labor">
      <div class="sh-labor-text">
        <h2 id="sh-labor">Gehäuse aus dem eigenen Drucklabor</h2>
        <p class="lead">
          Die Elektronik steckt in einer Figur: Eule, Spinne oder Astronaut. Gedruckt werden sie in derselben Werkstatt
          wie unsere Organizer, Ventilkappen und Golf-Tees. Smart Home und 3D-Druck sind bei KohliLab zwei Bereiche
          aus einer Hand.
        </p>
        <a class="sh-zum-druck" href="/#produkte-3d-druck" data-vorlade={druckVorlade}>Zum 3D-Druck →</a>
      </div>
      <ul class="sh-figuren">
        {figuren.map((f) => (
          <li>
            <img src={f.bild} alt={f.alt} width="900" height="900" loading="lazy" decoding="async" />
            <span>{f.name}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* Kopf: wie die Startseite, aber mit türkisem Licht statt orangem */
  .sh-held { display: grid; grid-template-columns: 1.05fr .95fr; gap: 34px; align-items: center; padding: 64px 26px 52px;
    background: radial-gradient(760px 420px at 82% 18%, rgba(34, 227, 232, .10), transparent 62%); }
  .sh-held .sub { max-width: 500px; }
  .sh-held-bild { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid #24494b;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .4), 0 22px 60px rgba(0, 0, 0, .5), 0 0 70px rgba(34, 227, 232, .10); aspect-ratio: 16 / 9; }
  .sh-held-bild img { width: 100%; height: 100%; object-fit: cover; }
  .sh-held-bild::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent 55%, rgba(20, 21, 23, .35)); }

  /* Geräte */
  .sh-geraete { display: grid; grid-template-columns: 1.65fr 1fr; gap: 18px; }
  .sh-geraet { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
    display: grid; grid-template-rows: auto 1fr; transition: border-color .15s; }
  .sh-geraet:hover { border-color: var(--sh); }
  .sh-geraet-bild { display: block; aspect-ratio: 16 / 9; background: #101214; }
  .sh-geraet-bild img { width: 100%; height: 100%; object-fit: cover; }
  .sh-geraet-text { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; }
  .sh-marke { align-self: flex-start; font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 1.6px;
    text-transform: uppercase; color: #061617; background: var(--sh); border-radius: 3px; padding: 3px 8px; }
  .sh-geraet h3 { font-family: var(--disp); font-weight: 500; font-size: 24px; letter-spacing: .5px; text-transform: uppercase; }
  .sh-geraet h3 a:hover { color: var(--sh); }
  .sh-geraet p { color: var(--muted); font-size: 14px; line-height: 1.6; }
  .sh-merkmale { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .sh-merkmale li { font-family: var(--mono); font-size: 11px; letter-spacing: 1px; color: var(--sh2);
    border: 1px solid #2a5254; border-radius: 3px; padding: 3px 7px; background: rgba(34, 227, 232, .05); }
  .sh-weiter { margin-top: auto; padding-top: 8px; align-self: flex-start; font-family: var(--mono); font-size: 12.5px;
    letter-spacing: 1.2px; text-transform: uppercase; color: var(--sh); }
  .sh-weiter:hover { color: var(--sh2); }
  .sh-folgt { background: transparent; border-style: dashed; }
  .sh-folgt:hover { border-color: var(--line2); }
  .sh-folgt-zeichen { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; color: #36676a; }

  /* Brücke zum 3D-Druck */
  .sh-labor { display: grid; grid-template-columns: .9fr 1.1fr; gap: 30px; align-items: center;
    border-top: 1px solid var(--line); }
  .sh-labor .lead { margin-bottom: 18px; }
  .sh-zum-druck { font-family: var(--mono); font-size: 12.5px; letter-spacing: 1.2px; text-transform: uppercase;
    color: #ff6b1a; padding: 8px 0; display: inline-block; }
  .sh-zum-druck:hover { color: #ffb347; }
  .sh-figuren { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .sh-figuren li { background: radial-gradient(circle at 50% 42%, #2a2d31, #1b1d20 72%); border: 1px solid var(--line);
    border-radius: 8px; padding: 10px 10px 12px; text-align: center; }
  .sh-figuren img { width: 100%; height: auto; aspect-ratio: 1; }
  .sh-figuren span { display: block; margin-top: 4px; font-family: var(--mono); font-size: 11.5px; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--muted); }

  @media (max-width: 860px) {
    .sh-held { grid-template-columns: 1fr; padding-top: 44px; }
    .sh-geraete, .sh-labor { grid-template-columns: 1fr; }
    .sh-folgt-zeichen { aspect-ratio: auto; padding: 26px 0 4px; }
    .specs { flex-wrap: wrap; gap: 18px 26px; }
  }
  @media (max-width: 480px) {
    .sh-figuren { gap: 8px; }
    .sh-figuren li { padding: 6px 6px 8px; }
  }
</style>

---
// Zentrale Produktlinien-Übersicht auf der Startseite, in zwei Bereichen (Manolo 14.11.2026): «3D-Druck» (Schwarz/Orange)
// und «Smart Home» (Akzent Türkis). Die Linien stehen in src/data/produktlinien.ts — neue Linien dort ergänzen, jede
// Linie bekommt eine eigene Unterseite.
import { BEREICHE, linienIn, type Bereich } from '../data/produktlinien';
const bereiche: Bereich[] = ['3d-druck', 'smart-home'];
---
<section class="block" id="produkte">
  <h2>Produktlinien</h2>
  <p class="lead">Alles aus einer Werkstatt, in zwei Bereichen: 3D-Druck nach Mass, jede Linie mit eigenem Konfigurator oder eigener Fabrik dahinter, und neu Smart Home.</p>
  {bereiche.map((b) => (
    <div class={`bereich ${b === 'smart-home' ? 'bereich-sh sh-akzent' : ''}`} id={BEREICHE[b].anker}>
      <div class="bereich-kopf">
        <h3 class="bereich-name">{BEREICHE[b].name}</h3>
        {b === 'smart-home' && <span class="bereich-neu">Neu</span>}
        <span class="bereich-zeile">{BEREICHE[b].zeile}</span>
        {b === 'smart-home' && <a class="bereich-mehr" href="/smart-home">Alles zu Smart Home →</a>}
      </div>
      <div class="cards">
        {linienIn(b).map((l) => (
          <a class={`card linie ${l.href ? '' : 'stumm'}`} href={l.href ?? undefined}>
            <div class="thumb linie-thumb">
              {b === 'smart-home' ? (
                <span class="tag tag-sh">{l.status === 'bald' ? 'SMART HOME · BALD' : 'SMART HOME'}</span>
              ) : (
                <>
                  {l.status === 'live' && <span class="tag">LIVE</span>}
                  {l.status === 'test' && <span class="tag tag-test">TEST</span>}
                  {l.status === 'bald' && <span class="tag tag-dim">BALD</span>}
                </>
              )}
              {l.bild ? (
                <img src={l.bild} alt={l.alt} loading="lazy" decoding="async" width={l.breite} height={l.hoehe} />
              ) : l.status === 'bald' ? (
                <svg width="84" height="100" viewBox="0 0 90 110" aria-hidden="true"><rect x="20" y="30" width="50" height="50" rx="6" fill="none" stroke="#9a9a93" stroke-width="4" stroke-dasharray="8 6"/><text x="45" y="63" text-anchor="middle" fill="#9a9a93" font-size="26" font-family="monospace">?</text></svg>
              ) : (
                <svg width="84" height="100" viewBox="0 0 90 110" aria-hidden="true"><path d="M45 25 v40 M25 45 h40" stroke="#ff6b1a" stroke-width="5" stroke-linecap="round"/><circle cx="45" cy="45" r="34" fill="none" stroke="#e8e6e1" stroke-width="4"/></svg>
              )}
            </div>
            <div class="meta">
              <div>
                <div class="nm">{l.name}</div>
                <div class="ds">{l.beschreibung}</div>
                {l.status === 'test' && <div class="ds" style="color:#c9a6ec;margin-top:5px">Testphase — ausprobieren ja, bestellen noch nicht</div>}
                {l.status === 'bald' && b === 'smart-home' && <div class="ds ds-bald">Bald erhältlich</div>}
              </div>
            </div>
          </a>
        ))}
        {b === 'smart-home' && (
          <div class="card linie card-folgt">
            <div class="thumb linie-thumb">
              <svg width="96" height="96" viewBox="0 0 96 96" aria-hidden="true"><rect x="14" y="14" width="68" height="68" rx="10" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="7 6"/><path d="M48 34 v28 M34 48 h28" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
            </div>
            <div class="meta"><div><div class="nm">Das nächste Gerät</div><div class="ds">entsteht gerade in der Werkstatt.</div></div></div>
          </div>
        )}
      </div>
    </div>
  ))}
</section>

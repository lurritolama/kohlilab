---
import { sujets as sujetsStatisch, preisFormat } from '../data/sujets.js';

// Sujets kommen bevorzugt von der Seite (serverseitig aus der gemeinsamen
// Supabase geladen); ohne Prop greift das eingebettete sujets.json.
const { sujets = sujetsStatisch } = Astro.props;

// Inline-Platzhalter-Grafiken bis echte Render-/Produktfotos da sind.
const icons: Record<string, string> = {
  pokal: `<svg width="90" height="110" viewBox="0 0 90 110"><path d="M25 15 h40 v14 a20 20 0 0 1 -40 0 z" fill="none" stroke="#e8e6e1" stroke-width="4"/><path d="M45 52 v10 M32 62 h26" stroke="#e8e6e1" stroke-width="4" fill="none"/><rect x="30" y="66" width="30" height="26" rx="3" fill="none" stroke="#ff6b1a" stroke-width="3"/></svg>`,
  leuchtturm: `<svg width="90" height="110" viewBox="0 0 90 110"><path d="M38 12 h14 l6 50 h-26 z" fill="none" stroke="#e8e6e1" stroke-width="4"/><path d="M30 30 h30" stroke="#e8e6e1" stroke-width="3"/><rect x="30" y="66" width="30" height="26" rx="3" fill="none" stroke="#ff6b1a" stroke-width="3"/></svg>`,
  totenkopf: `<svg width="90" height="110" viewBox="0 0 90 110"><circle cx="45" cy="34" r="22" fill="none" stroke="#e8e6e1" stroke-width="4"/><circle cx="37" cy="30" r="4" fill="#e8e6e1"/><circle cx="53" cy="30" r="4" fill="#e8e6e1"/><path d="M39 46 h12" stroke="#e8e6e1" stroke-width="3"/><rect x="30" y="66" width="30" height="26" rx="3" fill="none" stroke="#ff6b1a" stroke-width="3"/></svg>`,
};
---
<section class="block" id="sujets">
  <h2>Aktuelle Sujets</h2>
  <p class="lead">Frisch aus der Mikrofabrik — limitiert, bis der Trend weiterzieht.</p>
  {/* Filter + Suche (UX-Durchgang, Punkt 12): 22 Karten am Stueck sind zu viel
      zum Durchscrollen. Rein clientseitig ueber data-Attribute der Karten;
      die Wunsch-Karte bleibt immer sichtbar. */}
  <div class="sujet-filter" data-sujet-filter>
    <div class="sf-chips" role="group" aria-label="Sujets filtern">
      <button type="button" class="sf-chip is-on" data-filter="alle">Alle <span data-anzahl="alle"></span></button>
      <button type="button" class="sf-chip" data-filter="neu">Neu <span data-anzahl="neu"></span></button>
      <button type="button" class="sf-chip" data-filter="foto">Schon gedruckt <span data-anzahl="foto"></span></button>
    </div>
    <label class="sf-suche"><span class="sr-only">Sujet suchen</span><input type="search" placeholder="Sujet suchen …" data-suche autocomplete="off" /></label>
  </div>
  <p class="sf-leer" data-sf-leer hidden>Kein Sujet passt — anderes Wort probieren oder ein <a href="#wunsch">Wunsch-Sujet</a> bestellen.</p>
  <div class="cards">
    {sujets.map((s) => (
      <div class="card" data-sujet-karte data-neu={s.neu ? '1' : '0'} data-foto={s.bildTyp === 'foto' ? '1' : '0'} data-such={`${s.name} ${s.beschreibung ?? ''}`.toLowerCase()}>
        <div class="thumb">
          {s.neu && <span class="tag">NEU</span>}
          {s.bild
            ? <img src={s.bild} alt={s.name} loading="lazy" />
            : <Fragment set:html={icons[s.slug] ?? ''} />}
          {s.bild && s.bildTyp !== 'foto' && (
            <span class="bildhinweis" title="Bild aus dem 3D-Modell gerendert — Farben und Oberfläche können vom gedruckten Teil abweichen.">Renderbild</span>
          )}
        </div>
        <div class="meta">
          <div>
            <div class="nm">{s.name}</div>
            <div class="ds">{s.beschreibung}</div>
          </div>
          <div class="pr">{preisFormat(s.preisRappen)}<span class="pr-set">4er-Set</span></div>
        </div>
        {/* Der Hinweis steht als sichtbarer Satz da, nicht nur als title-Tooltip:
            auf dem Handy gibt es kein Hover, und genau dort wird bestellt. */}
        {s.bild && s.bildTyp !== 'foto' && (
          <p class="bildnote">Bild aus dem 3D-Modell gerendert — <b>Farben und Oberfläche können vom gedruckten Teil abweichen.</b> Sobald das Sujet gedruckt ist, ersetzen wir es durch ein Foto.</p>
        )}
        {s.bild ? (
          <div class="order" data-sujet={s.slug} data-name={s.name} data-rappen={s.preisRappen}>
            <div class="gw" role="group" aria-label="Gewinde wählen">
              <button type="button" class="gw-opt is-on" data-gw="schrader">Schrader<small>Auto / Velo</small></button>
              <button type="button" class="gw-opt" data-gw="presta">Presta<small>Rennvelo</small></button>
            </div>
            <button type="button" class="btn-cart" data-add>In den Warenkorb</button>
          </div>
        ) : (
          <div class="order order--bald"><span>In Vorbereitung</span></div>
        )}
      </div>
    ))}
    <div class="card card--wunsch" id="wunsch">
      <div class="thumb">
        <span class="tag tag-wunsch">WUNSCH</span>
        <svg width="90" height="110" viewBox="0 0 90 110"><path d="M30 78 L62 30 l10 7 -32 48 -14 5 z" fill="none" stroke="#ff6b1a" stroke-width="4" stroke-linejoin="round"/><path d="M58 36 l10 7" stroke="#ff6b1a" stroke-width="3"/><rect x="30" y="88" width="30" height="14" rx="3" fill="none" stroke="#e8e6e1" stroke-width="3"/></svg>
      </div>
      <div class="meta">
        <div>
          <div class="nm">Dein Wunsch-Sujet</div>
          <div class="ds">Beschreib dein Motiv — die Mikrofabrik entwirft es als Ventilkappe. Wir prüfen zuerst, ob es druckbar ist.</div>
        </div>
        <div class="pr">{preisFormat(2000)}<span class="pr-set">4er-Set</span></div>
      </div>
      <div class="order order--wunsch" data-wunsch data-rappen="2000">
        <textarea data-wunsch-text maxlength="200" rows="2"
          placeholder="z. B. «kleiner Fliegenpilz» oder «Berggipfel mit Kreuz» — kompakte Motive funktionieren am besten"></textarea>
        <div class="gw" role="group" aria-label="Gewinde wählen">
          <button type="button" class="gw-opt is-on" data-gw="schrader">Schrader<small>Auto / Velo</small></button>
          <button type="button" class="gw-opt" data-gw="presta">Presta<small>Rennvelo</small></button>
        </div>
        <button type="button" class="btn-cart" data-add>In den Warenkorb</button>
        <p class="wunsch-note">CHF 20.— je 4er-Set (CHF 12.— + 8.— Wunsch-Aufpreis). <b>Wir prüfen die Machbarkeit nach der Bestellung</b> — feine Details, dünne Anbauten und geschützte Motive gehen nicht. Falls dein Motiv nicht umsetzbar ist, stornieren wir kostenlos und du zahlst nichts.</p>
      </div>
    </div>
  </div>
  <p class="setnote">Preise gelten pro 4er-Set (4 Ventilkappen). Wähle je Sujet dein Ventilgewinde: <b>Schrader</b> (Auto und die meisten Velos) oder <b>Presta</b> (Rennvelo).</p>
  <button type="button" class="nach-oben" data-nach-oben hidden aria-label="Nach oben">↑ oben</button>
</section>

<style>
  .sujet-filter { display:flex; flex-wrap:wrap; gap:10px 16px; align-items:center; margin:-4px 0 18px; }
  .sf-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .sf-chip {
    background:transparent; color:var(--mut,#9a9a93); border:1px solid var(--line,#33373c); border-radius:999px;
    padding:9px 14px; min-height:40px; font-family:var(--mono,monospace); font-size:0.78rem; letter-spacing:0.08em;
    text-transform:uppercase; cursor:pointer;
  }
  .sf-chip span { opacity:.7; margin-left:3px; }
  .sf-chip.is-on { border-color:var(--acc,#ff6b1a); color:var(--acc,#ff6b1a); background:rgba(255,107,26,0.08); }
  .sf-suche { flex:1 1 200px; max-width:320px; }
  .sf-suche input {
    width:100%; min-height:40px; background:#17181b; border:1px solid var(--line,#33373c); border-radius:999px;
    color:var(--ink,#e8e6e1); padding:8px 16px; font-size:16px; font-family:inherit;
  }
  .sf-suche input:focus { outline:none; border-color:var(--acc,#ff6b1a); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  .sf-leer { color:var(--mut,#9a9a93); margin:0 0 14px; }
  .card.sf-aus { display:none; }
  .nach-oben {
    position:fixed; right:16px; bottom:18px; z-index:40;
    background:var(--panel,#1c1e21); color:var(--ink,#e8e6e1); border:1px solid var(--line,#33373c);
    border-radius:999px; padding:11px 15px; min-height:44px; font-size:0.85rem; cursor:pointer;
    box-shadow:0 8px 24px rgba(0,0,0,.45);
  }
  .nach-oben:hover { border-color:var(--acc,#ff6b1a); color:var(--acc,#ff6b1a); }

  .pr { display:flex; flex-direction:column; align-items:flex-end; line-height:1.12; }
  .pr-set { font-size:0.78rem; font-weight:400; letter-spacing:0.02em; color:var(--mut,#9a9a93); text-transform:uppercase; }
  .setnote { margin:1.2rem 0 0; font-size:0.8rem; color:var(--mut,#9a9a93); }

  .bildnote { margin:-0.35rem 16px 0; font-size:0.8rem; line-height:1.45; color:var(--mut,#9a9a93); }
  .bildnote b { color:var(--ink,#e8e6e1); font-weight:600; }

  .order { margin-top:0.9rem; display:flex; flex-direction:column; gap:0.55rem; }
  .order--bald { align-items:flex-start; }
  .order--bald span {
    font-family:var(--mono,monospace); font-size:0.75rem; letter-spacing:0.12em;
    text-transform:uppercase; color:var(--mut,#9a9a93);
    border:1px solid var(--line,#33373c); border-radius:999px; padding:0.3rem 0.7rem;
  }
  .gw { display:flex; gap:0.4rem; }
  .gw-opt {
    flex:1; display:flex; flex-direction:column; gap:1px; align-items:center;
    padding:0.4rem 0.3rem; border:1px solid var(--line,#33373c); border-radius:7px;
    background:transparent; color:var(--ink,#e8e6e1); cursor:pointer;
    font-size:0.82rem; font-weight:600; line-height:1.1;
  }
  .gw-opt small { font-size:0.7rem; font-weight:400; color:var(--mut,#9a9a93); letter-spacing:0.02em; }
  .gw-opt.is-on { border-color:var(--acc,#ff6b1a); color:var(--acc,#ff6b1a); background:rgba(255,107,26,0.08); }
  .gw-opt.is-on small { color:var(--acc,#ff6b1a); }
  .btn-cart {
    width:100%; padding:0.6rem; border:none; border-radius:7px; cursor:pointer;
    background:var(--acc,#ff6b1a); color:#141517; font-weight:700; font-size:0.9rem;
    transition:filter .12s;
  }
  .btn-cart:hover { filter:brightness(1.08); }
  .btn-cart.ok { background:#4ade80; }

  .card--wunsch { border-style:dashed; }
  .tag-wunsch { background:transparent; color:var(--acc,#ff6b1a); border:1px solid var(--acc,#ff6b1a); }
  .order--wunsch textarea {
    width:100%; resize:vertical; min-height:52px;
    background:#17181b; border:1px solid var(--line,#33373c); border-radius:7px;
    color:var(--ink,#e8e6e1); padding:0.5rem 0.6rem; font-size:0.82rem; font-family:inherit;
  }
  .order--wunsch textarea:focus { outline:none; border-color:var(--acc,#ff6b1a); }
  .wunsch-note { margin:0; font-size:0.8rem; line-height:1.45; color:var(--mut,#9a9a93); }
  .wunsch-note b { color:var(--ink,#e8e6e1); font-weight:600; }
</style>

<script>
  const chf = (r) => 'CHF ' + new Intl.NumberFormat('de-CH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(r / 100).replace(/\.00$/, '.—');
  const GW_LABEL = { schrader: 'Schrader', presta: 'Presta' };

  async function zaehlerAktualisieren() {
    try {
      const n = await window.KCart.count();
      const b = document.querySelector('[data-cart-count]');
      if (b) { b.textContent = String(n); b.style.display = n > 0 ? 'inline-flex' : 'none'; }
    } catch (e) {}
  }

  document.querySelectorAll('.order[data-sujet]').forEach((box) => {
    let gewinde = 'schrader';
    box.querySelectorAll('.gw-opt').forEach((opt) => {
      opt.addEventListener('click', () => {
        gewinde = opt.getAttribute('data-gw');
        box.querySelectorAll('.gw-opt').forEach((o) => o.classList.toggle('is-on', o === opt));
      });
    });
    const btn = box.querySelector('[data-add]');
    btn.addEventListener('click', async () => {
      const sujet = box.getAttribute('data-sujet');
      const name = box.getAttribute('data-name');
      const rappen = Number(box.getAttribute('data-rappen')) || 1200;
      await window.KCart.add({
        typ: 'ventilkappe',
        titel: `${name} · ${GW_LABEL[gewinde]} · 4er-Set`,
        menge: 1,
        stueckRappen: rappen,
        gesamtRappen: rappen,
        konfig: { sujet, gewinde },
        dateien: {},
      });
      await zaehlerAktualisieren();
      const alt = btn.textContent;
      btn.textContent = '✓ Im Warenkorb';
      btn.classList.add('ok');
      setTimeout(() => { btn.textContent = alt; btn.classList.remove('ok'); }, 1400);
    });
  });

  // Wunsch-Sujet: Freitext + Gewinde, CHF 17.— (12 + 5 Aufpreis).
  // Machbarkeit wird nach der Bestellung geprüft (Anfrage-Ablauf, QR-Rechnung
  // kommt erst nach Bestätigung zum Zug — bei Storno zahlt niemand).
  const wbox = document.querySelector('[data-wunsch]');
  if (wbox) {
    let gewinde = 'schrader';
    wbox.querySelectorAll('.gw-opt').forEach((opt) => {
      opt.addEventListener('click', () => {
        gewinde = opt.getAttribute('data-gw');
        wbox.querySelectorAll('.gw-opt').forEach((o) => o.classList.toggle('is-on', o === opt));
      });
    });
    const ta = wbox.querySelector('[data-wunsch-text]');
    const btn = wbox.querySelector('[data-add]');
    btn.addEventListener('click', async () => {
      const wunsch = (ta.value || '').trim();
      if (wunsch.length < 5) {
        ta.style.borderColor = '#f87171';
        ta.placeholder = 'Bitte beschreib dein Wunsch-Motiv (mind. 5 Zeichen) …';
        ta.focus();
        setTimeout(() => { ta.style.borderColor = ''; }, 1600);
        return;
      }
      const rappen = Number(wbox.getAttribute('data-rappen')) || 2000;
      const kurz = wunsch.length > 32 ? wunsch.slice(0, 32) + '…' : wunsch;
      await window.KCart.add({
        typ: 'ventilkappe',
        titel: `Wunsch-Sujet «${kurz}» · ${GW_LABEL[gewinde]} · 4er-Set`,
        menge: 1,
        stueckRappen: rappen,
        gesamtRappen: rappen,
        konfig: { sujet: 'wunsch', wunsch, gewinde },
        dateien: {},
      });
      await zaehlerAktualisieren();
      const alt = btn.textContent;
      btn.textContent = '✓ Im Warenkorb — wir prüfen die Machbarkeit';
      btn.classList.add('ok');
      setTimeout(() => { btn.textContent = alt; btn.classList.remove('ok'); }, 2200);
    });
  }

  // Filter + Suche + «nach oben» (UX-Durchgang 31.08.2026, Punkt 12).
  const filterBox = document.querySelector('[data-sujet-filter]');
  if (filterBox) {
    const karten = [...document.querySelectorAll('[data-sujet-karte]')];
    const leer = document.querySelector('[data-sf-leer]');
    const suche = filterBox.querySelector('[data-suche]');
    let filter = 'alle';
    const zaehle = (f) => karten.filter((k) => f === 'alle' || k.dataset[f] === '1').length;
    filterBox.querySelectorAll('[data-anzahl]').forEach((s) => { s.textContent = '(' + zaehle(s.dataset.anzahl) + ')'; });
    // Ein Filter, der nichts aussortiert (alle Sujets «neu») oder nichts
    // uebrig laesst, ist kein Filter — dann den Chip weglassen.
    filterBox.querySelectorAll('[data-filter]').forEach((chip) => {
      const f = chip.dataset.filter; if (f === 'alle') return;
      const n = zaehle(f); if (n === 0 || n === karten.length) chip.hidden = true;
    });
    if ([...filterBox.querySelectorAll('[data-filter]')].filter((c) => !c.hidden).length < 2) filterBox.querySelector('.sf-chips').hidden = true;
    const anwenden = () => {
      const q = (suche.value || '').trim().toLowerCase();
      let sichtbar = 0;
      for (const k of karten) {
        const passt = (filter === 'alle' || k.dataset[filter] === '1') && (!q || k.dataset.such.includes(q));
        k.classList.toggle('sf-aus', !passt);
        if (passt) sichtbar++;
      }
      leer.hidden = sichtbar > 0;
    };
    filterBox.querySelectorAll('[data-filter]').forEach((chip) => {
      chip.addEventListener('click', () => {
        filter = chip.dataset.filter;
        filterBox.querySelectorAll('[data-filter]').forEach((c) => c.classList.toggle('is-on', c === chip));
        anwenden();
      });
    });
    suche.addEventListener('input', anwenden);
  }
  const hoch = document.querySelector('[data-nach-oben]');
  if (hoch) {
    const pruefe = () => { hoch.hidden = window.scrollY < 900; };
    window.addEventListener('scroll', pruefe, { passive: true });
    pruefe();
    hoch.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  }
</script>

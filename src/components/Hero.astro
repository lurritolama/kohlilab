---
---
<section class="hero">
  <div>
    <span class="kicker">3D-gedruckte Ventilkappen</span>
    <h1>Die KI entwirft.<br /><span class="g">Der Mensch gibt frei.</span></h1>
    <p class="sub">
      Kleine Skulpturen mit Ventilgewinde im Sockel — entworfen von einer
      KI-Mikrofabrik, geprüft und gedruckt im Appenzellerland. Wahlweise
      Schrader oder Presta: passt auf Auto, Velo und Rennvelo.
    </p>
    <div class="cta">
      <a class="btn primary" href="#sujets">Aktuelle Sujets ansehen</a>
      <a class="btn ghost" href="#entstehung">Wie es funktioniert</a>
    </div>
    <div class="specs">
      <div><div class="n">TR4 · SV</div><div class="l">Schrader oder Presta</div></div>
      <div><div class="n">~30 mm</div><div class="l">Sujet-Grösse</div></div>
      <div><div class="n">1 Körper</div><div class="l">wasserdicht validiert</div></div>
    </div>
  </div>
  <div class="stage">
    <div class="plate plate--video">
      <video
        class="clip"
        src="/bilder/ventilkappen-druck.mp4"
        poster="/bilder/ventilkappen-titel.jpg"
        autoplay muted loop playsinline preload="metadata"
        aria-label="Vier Glace-Ventilkappen werden auf dem Bambu-H2D gedruckt"
      ></video>
      <span class="plabel">FRISCH VOM DRUCKBETT · GLACE</span>
    </div>
  </div>
</section>

<style>
  /* Hochformat-Clip (720×1280) statt der quadratischen Platzhalter-Platte. */
  .plate--video { aspect-ratio: 3 / 4; overflow: hidden; }
  .plate--video .clip {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    background: #1d1f22;
  }
  .plate--video .plabel {
    z-index: 1;
    background: rgba(20, 21, 23, 0.72);
    padding: 3px 8px; border-radius: 4px;
  }
</style>

<script>
  // Wer im System "Bewegung reduzieren" gewählt hat, bekommt das Standbild
  // statt der Endlosschleife — mit Bedienelementen zum bewussten Abspielen.
  const clip = document.querySelector('.plate--video .clip');
  if (clip && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    clip.removeAttribute('autoplay');
    clip.removeAttribute('loop');
    clip.setAttribute('controls', '');
    clip.pause();
    clip.currentTime = 0;
  }
</script>

---
// Self-hosted fonts (kein Google-CDN → DSGVO-sauber, schneller).
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'KohliLab — 3D-gedruckte Ventilkappen mit Charakter',
  description = 'Kleine Skulpturen mit Schrader-Gewinde im Sockel: 3D-gedruckte Ventilkappen aus der KI-Mikrofabrik im Appenzellerland. Passt auf jedes Auto- und Velo-Ventil.',
} = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141517" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-tex"></div>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

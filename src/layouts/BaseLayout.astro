---
// Self-hosted fonts (kein Google-CDN → DSGVO-sauber, schneller).
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** true fuer private Seiten (Werber-Ansicht) — haelt Suchmaschinen fern */
  noindex?: boolean;
  /** Vorschaubild beim Teilen (WhatsApp, Instagram, Suchmaschinen), Pfad ab
   *  Wurzel; Querformat, ideal 1200×630. Ohne Angabe das Standardbild. */
  bild?: string;
}
const {
  title = 'KohliLab — Du konfigurierst. Wir drucken.',
  description = 'Konfiguratoren für 3D-gedruckte Produkte nach Mass: Schubladen-Organizer, QR-Schilder, Golf-Tees und Module für die IKEA-Skådis-Lochwand — im Browser gestaltet, in Bühler AR gedruckt. Dazu Ventilkappen aus der KI-Mikrofabrik.',
  noindex = false,
  bild = '/bilder/og-standard.jpg',
} = Astro.props;
// Absolute Adressen fuer die Teilen-Vorschau (og:image muss absolut sein)
const site = 'https://kohlilab.ch';
const bildAbs = bild.startsWith('http') ? bild : site + bild;
// build.format 'file' liefert den Pfad als /golf-tees.html — nach aussen gilt /golf-tees
const seiteAbs = site + Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#141517" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seiteAbs} />
    <meta property="og:image" content={bildAbs} />
    <meta property="og:site_name" content="KohliLab" />
    <meta property="og:locale" content="de_CH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={bildAbs} />
    <title>{title}</title>
    {/* Zweiter Teil des Skripts: Vorhang-Übergang von der Startseite (Manolo 17.11.2026). Hat die Eule dort eben den
        Theatervorhang zugezogen (public/eule/vorhang/…/vorhang.js), steht im sessionStorage das Merkzeichen «kl_vorhang»
        (Zeit, Zielpfad, Fassung der Dateien). Nur dann, nur auf der Zielseite und nur wenige Sekunden lang beginnt die
        Seite hinter einer dunklen Decke, hält das Bild der alten Seite (Vorhang zu) fest und holt den Film «auf» (liegt
        schon im Zwischenspeicher) und vorhang.js, das den Vorhang aufzieht. Kommt es nicht (Fehler, 2,5 s), fällt die
        Decke von selbst. Bei jedem normalen Aufruf fehlt das Merkzeichen und es passiert nichts.
        Quelle und Beschrieb: RaspiCam, zaehler/e450/gemeinsam/webseite/eule_vorhang. */}
    <script is:inline>
      // Seitenübergang (global.css, @view-transition) nur beim Abflug der Eule von der Startseite: eule.js setzt dann
      // window.klUebergang. Bei allen anderen Seitenwechseln wird er übersprungen, dort bleibt alles wie bisher.
      // (ready.catch: ein übersprungener Übergang lehnt «ready» ab, das soll nicht als Fehler in der Konsole landen)
      addEventListener('pageswap', function (e) { var v = e.viewTransition; if (v && !window.klUebergang) { v.ready.catch(function () {}); v.skipTransition(); } });
      (function () {
        try {
          var m = JSON.parse(sessionStorage.getItem('kl_vorhang')), d = document, h = d.documentElement;
          if (!m) return;
          sessionStorage.removeItem('kl_vorhang');
          if (Date.now() - m.t > 9e3 || m.z !== location.pathname || !/^[a-z0-9]{6,20}$/.test(m.v)) return;
          var st = d.createElement('style'), s = d.createElement('script'), f = m.f = d.createElement('video'), p = '/eule/vorhang/' + m.v + '/';
          st.textContent = 'html.kl-vh::before{content:"";position:fixed;inset:0;z-index:2147483646;background:#0c1a1d}html.kl-vh::view-transition-old(root){animation:kl-vh 6s both}html.kl-vh::view-transition-new(root){animation:none;opacity:0}@keyframes kl-vh{from,to{opacity:1}}';
          f.muted = f.playsInline = true; f.preload = 'auto'; f.src = p + (m.q == 'hoch' ? 'auf-hoch.mp4' : 'auf-quer.mp4');
          m.weg = function () { h.classList.remove('kl-vh'); try { m.vt.skipTransition(); } catch (e) {} };
          addEventListener('pagereveal', function (e) { if ((m.vt = e.viewTransition)) m.vt.ready.catch(function () {}); });
          s.src = p + 'vorhang.js'; s.onerror = m.weg;
          setTimeout(function () { m.da || m.weg(); }, 2500);
          window.klVorhang = m; h.classList.add('kl-vh'); d.head.append(st, s);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="bg-tex"></div>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script src="/kcart.js" is:inline></script>
    <script is:inline>
      // Empfehlungs-Link der Werber (kohlilab.ch/w/KUERZEL -> /?w=KUERZEL):
      // Kürzel 30 Tage im Browser merken, der Checkout trägt es dann vor.
      // Der letzte Link gewinnt. Kein Cookie, kein Dritter, nur ein Kürzel im
      // localStorage — braucht keinen Banner. Der Parameter wird aus der
      // Adresszeile entfernt, damit er nicht in Lesezeichen und Teilen-Links
      // weiterwandert.
      window.KWerber = (function(){
        const KEY = 'kl_werber', TAGE = 30;
        function lies(){ try { const d = JSON.parse(localStorage.getItem(KEY) || 'null'); if (!d || !d.k) return ''; if (Date.now() - d.t > TAGE*86400e3) { localStorage.removeItem(KEY); return ''; } return d.k; } catch(e){ return ''; } }
        function merke(k){ try { localStorage.setItem(KEY, JSON.stringify({ k: k, t: Date.now() })); } catch(e){} }
        try {
          const u = new URL(location.href), w = (u.searchParams.get('w') || '').trim().toUpperCase();
          if (/^[A-Z0-9]{2,20}$/.test(w)) { merke(w); u.searchParams.delete('w'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); }
        } catch(e){}
        return { get: lies };
      })();
      // Warenkorb-Zähler im Header live halten
      (function(){
        async function upd(){ try { const n = await window.KCart.count(); const b = document.querySelector('[data-cart-count]'); if(b){ b.textContent = n; b.style.display = n>0 ? 'inline-flex' : 'none'; } } catch(e){} }
        window.addEventListener('pageshow', upd); document.addEventListener('DOMContentLoaded', upd); upd();
      })();
    </script>
  </body>
</html>

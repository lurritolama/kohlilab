---
// Self-hosted fonts (kein Google-CDN → DSGVO-sauber, schneller).
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** true fuer private Seiten (Werber-Ansicht) — haelt Suchmaschinen fern */
  noindex?: boolean;
}
const {
  title = 'KohliLab — Du konfigurierst. Wir drucken.',
  description = 'Konfiguratoren für 3D-gedruckte Produkte nach Mass: QR-Schilder, Schubladen-Organizer und mehr — im Browser gestaltet, in Bühler AR gedruckt. Dazu Ventilkappen aus der KI-Mikrofabrik.',
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#141517" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-tex"></div>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script src="/kcart.js" is:inline></script>
    <script is:inline>
      // Empfehlungs-Link der Werber (kohlilab.ch/w/KUERZEL -> /?w=KUERZEL):
      // Kürzel 30 Tage im Browser merken, der Checkout trägt es dann vor.
      // Der letzte Link gewinnt. Kein Cookie, kein Dritter, nur ein Kürzel im
      // localStorage — braucht keinen Banner. Der Parameter wird aus der
      // Adresszeile entfernt, damit er nicht in Lesezeichen und Teilen-Links
      // weiterwandert.
      window.KWerber = (function(){
        const KEY = 'kl_werber', TAGE = 30;
        function lies(){ try { const d = JSON.parse(localStorage.getItem(KEY) || 'null'); if (!d || !d.k) return ''; if (Date.now() - d.t > TAGE*86400e3) { localStorage.removeItem(KEY); return ''; } return d.k; } catch(e){ return ''; } }
        function merke(k){ try { localStorage.setItem(KEY, JSON.stringify({ k: k, t: Date.now() })); } catch(e){} }
        try {
          const u = new URL(location.href), w = (u.searchParams.get('w') || '').trim().toUpperCase();
          if (/^[A-Z0-9]{2,20}$/.test(w)) { merke(w); u.searchParams.delete('w'); history.replaceState(null, '', u.pathname + (u.search || '') + u.hash); }
        } catch(e){}
        return { get: lies };
      })();
      // Warenkorb-Zähler im Header live halten
      (function(){
        async function upd(){ try { const n = await window.KCart.count(); const b = document.querySelector('[data-cart-count]'); if(b){ b.textContent = n; b.style.display = n>0 ? 'inline-flex' : 'none'; } } catch(e){} }
        window.addEventListener('pageshow', upd); document.addEventListener('DOMContentLoaded', upd); upd();
      })();
    </script>
  </body>
</html>
